# Copiar a .env en la raíz de 03_laboratorio. Nunca agregar claves a este ejemplo.
# Las variables de la terminal tienen prioridad sobre este archivo.
LLM_BACKEND=groq
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
# Tu propia clave de Groq (https://console.groq.com/keys). Empieza por gsk y no se comparte.
GROQ_API_KEY=

# Modelo local opcional (no hace falta en el laboratorio): LM Studio con un modelo cargado como demo-local.
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=demo-local
LOCAL_REASONING_EFFORT=none
